<?xml version="1.0" encoding="utf-8"?>
<!--
  Networld VPN — MSIX package manifest (Desktop Bridge / full-trust Win32).

  The three values marked REPLACE-ME come from Partner Center →
  Product → Product identity. Build-Msix.ps1 rewrites them for you:

      .\packaging\msix\Build-Msix.ps1 `
          -IdentityName  "12345Networld.NetworldVPN" `
          -Publisher     "CN=A1B2C3D4-5E6F-7890-ABCD-EF1234567890" `
          -PublisherDisplayName "Networld"
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap3="http://schemas.microsoft.com/appx/manifest/uap/windows10/3"
  xmlns:uap5="http://schemas.microsoft.com/appx/manifest/uap/windows10/5"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap3 uap5 desktop rescap">

  <Identity
    Name="REPLACE-ME.NetworldVPN"
    Publisher="CN=REPLACE-ME"
    Version="1.0.0.0"
    ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>Networld VPN</DisplayName>
    <PublisherDisplayName>REPLACE-ME</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <Description>Multi-protocol tunnelling client with SSH, SSH-over-TLS, HTTP payload injection, V2Ray/Xray, split tunnelling and a kill switch.</Description>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.22621.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Applications>
    <Application Id="NetworldVPN" Executable="NetworldVPN.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="Networld VPN"
        Description="Multi-protocol tunnelling client for Windows."
        BackgroundColor="#0B1220"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile
          Wide310x150Logo="Assets\Wide310x150Logo.png"
          Square71x71Logo="Assets\Square71x71Logo.png"
          Square310x310Logo="Assets\Square310x310Logo.png"
          ShortName="Networld VPN">
          <uap:ShowNameOnTiles>
            <uap:ShowOn Tile="square150x150Logo" />
            <uap:ShowOn Tile="wide310x150Logo" />
          </uap:ShowNameOnTiles>
        </uap:DefaultTile>
        <uap:SplashScreen Image="Assets\SplashScreen.png" BackgroundColor="#0B1220" />
        <uap:LockScreen BadgeLogo="Assets\LockScreenLogo.png" Notification="badge" />
      </uap:VisualElements>

      <Extensions>
        <!-- One-click config import: networld://<base64 profile> -->
        <uap:Extension Category="windows.protocol">
          <uap:Protocol Name="networld" DesiredView="useLess">
            <uap:DisplayName>Networld VPN configuration</uap:DisplayName>
            <uap:Logo>Assets\Square44x44Logo.png</uap:Logo>
          </uap:Protocol>
        </uap:Extension>

        <!-- Double-click a .nw config bundle -->
        <uap:Extension Category="windows.fileTypeAssociation">
          <uap3:FileTypeAssociation Name="nw">
            <uap:DisplayName>Networld VPN config</uap:DisplayName>
            <uap:Logo>Assets\Square44x44Logo.png</uap:Logo>
            <uap:SupportedFileTypes>
              <uap:FileType ContentType="application/x-networld-config">.nw</uap:FileType>
            </uap:SupportedFileTypes>
          </uap3:FileTypeAssociation>
        </uap:Extension>

        <!-- "Start with Windows" toggle in Settings drives this task -->
        <desktop:Extension Category="windows.startupTask" Executable="NetworldVPN.exe" EntryPoint="Windows.FullTrustApplication">
          <desktop:StartupTask TaskId="NetworldVPNAutostart" Enabled="false" DisplayName="Networld VPN" />
        </desktop:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <!-- Outbound tunnelling + local SOCKS/HTTP listeners -->
    <Capability Name="internetClient" />
    <Capability Name="internetClientServer" />
    <Capability Name="privateNetworkClientServer" />
    <!-- Required for any Win32 (Desktop Bridge) payload -->
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
